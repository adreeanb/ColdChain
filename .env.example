MQTT_USERNAME="coldchain-api"
MQTT_PASSWORD="troque-esta-senha"
MQTT_DEVICE_USERNAME="coldchain-device"
MQTT_DEVICE_PASSWORD="troque-esta-senha-das-placas"
# MQTT_CLIENT_ID="coldchain-api"   # fixo: o broker guarda as mensagens enquanto a API estiver fora

