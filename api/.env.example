# Em produção use NODE_ENV=production: a API não sobe com segredo fraco, valor de exemplo ou CORS ausente
# NODE_ENV=production

# Banco do docker-compose. POSTGRES_* criam o banco; DATABASE_URL precisa usar os mesmos valores.
POSTGRES_USER="appuser"
POSTGRES_PASSWORD="troque-esta-senha-do-banco"
POSTGRES_DB="TCC_ColdChain_db"
DATABASE_URL="postgresql://appuser:troque-esta-senha-do-banco@localhost:5433/TCC_ColdChain_db?schema=public"

PORT=3334
# Pelo menos 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo"

# Origens do web, separadas por vírgula (ex.: https://app.seudominio.com)
CORS_ORIGINS="http://localhost:5173"

# Broker do docker-compose (mosquitto). A API entra com MQTT_USERNAME; as placas, com MQTT_DEVICE_*.
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME="coldchain-api"
MQTT_PASSWORD="troque-esta-senha"
MQTT_DEVICE_USERNAME="coldchain-device"
MQTT_DEVICE_PASSWORD="troque-esta-senha-das-placas"
# MQTT_CLIENT_ID="coldchain-api"   # fixo: o broker guarda as mensagens enquanto a API estiver fora

# Usuário MASTER criado por `npx prisma db seed` (só na primeira vez; depois, troque a senha pela tela de perfil)
SEED_MASTER_NAME="Administrador"
SEED_MASTER_EMAIL="master@coldchain.local"
SEED_MASTER_PASSWORD="troque-esta-senha-do-master"

# Opcionais
# TRUST_PROXY=1                    # atrás de proxy reverso (Caddy/Nginx): número de proxies à frente da API
# QUARANTINE_TTL_HOURS=2
# SENSOR_OFFLINE_MINUTES=10
