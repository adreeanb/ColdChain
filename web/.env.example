# Endereço da API para o proxy do Vite (/api). Use a porta definida no .env da API.
API_PROXY_TARGET=http://localhost:3001

# true serve o app em HTTPS na rede local, necessário para a câmera do celular
DEV_HTTPS=false

# Em produção, a URL da API quando não houver proxy reverso em /api
# VITE_API_URL=https://api.exemplo.com
